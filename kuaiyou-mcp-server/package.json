{
  "name": "autoace-cli",
  "version": "1.0.2",
  "description": "autoace-cli — MCP CLI for Kuaiyou Master Android automation. Lets Cursor/Claude control the phone and push skills.",
  "main": "./build/index.js",
  "bin": {
    "autoace-cli": "build/index.js",
    "kuaiyou-mcp-server": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "build": "tsup",
    "build:schema": "npm run build && node scripts/build-schema.mjs",
    "check:schema": "npm run build && node scripts/check-schema-compat.mjs",
    "prepack": "npm run build",
    "start": "node build/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "android",
    "automation",
    "kuaiyou",
    "reactive-skill"
  ],
  "author": "kuaiyou-app",
  "license": "Apache-2.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuaiyou-app/kuaiyou-open-source.git",
    "directory": "kuaiyou-mcp-server"
  },
  "homepage": "https://github.com/kuaiyou-app/kuaiyou-open-source/tree/main/kuaiyou-mcp-server",
  "bugs": {
    "url": "https://github.com/kuaiyou-app/kuaiyou-open-source/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "directories": {
    "test": "test"
  }
}
